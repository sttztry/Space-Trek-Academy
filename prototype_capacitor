#include <Wire.h>

// I2C Address for AD7746 on EVAL-CN0552-PMDZ
#define AD7746_I2C_ADDR 0x48 

// AD7746 Register Definitions
#define AD7746_REG_STATUS      0x00
#define AD7746_REG_CAP_DATA    0x01
#define AD7746_REG_CAP_SETUP   0x07
#define AD7746_REG_CONFIG      0x09

// =========================================================================
// GROUND CALIBRATION VALUES (Update these after running empty-tube tests)
// =========================================================================
const float C_DRY_PF       = 2.150; // Measured capacitance of empty tube + air (pF)
const float C_PARASITIC_PF = 0.200; // Measured parasitic capacitance of wires alone (pF)

// =========================================================================
// EVAL-CN0552-PMDZ (AD7746) DRIVER FUNCTIONS
// =========================================================================

void initEVAL_CN0552() {
  Wire.begin();
  
  // 1. Configure Capacitance Setup Register (0x07)
  // 0xA0 = Enable Capacitance Conversion, Continuous Conversion Mode
  Wire.beginTransmission(AD7746_I2C_ADDR);
  Wire.write(AD7746_REG_CAP_SETUP);
  Wire.write(0xA0); 
  Wire.endTransmission();

  // 2. Configure Configuration Register (0x09)
  // 0x01 = Internal clock, set conversion time to ~110 ms per sample
  Wire.beginTransmission(AD7746_I2C_ADDR);
  Wire.write(AD7746_REG_CONFIG);
  Wire.write(0x01); 
  Wire.endTransmission();
}

float readCapacitancePF() {
  Wire.beginTransmission(AD7746_I2C_ADDR);
  Wire.write(AD7746_REG_CAP_DATA);
  Wire.endTransmission(false);

  // Request 3 bytes of raw 24-bit capacitance data
  Wire.requestFrom(AD7746_I2C_ADDR, 3);
  if (Wire.available() == 3) {
    uint32_t rawData = ((uint32_t)Wire.read() << 16) | 
                       ((uint32_t)Wire.read() << 8)  | 
                        (uint32_t)Wire.read();
    
    // AD7746 24-bit conversion formula (Full Scale Range = ±4.096 pF)
    // 0x800000 (8388608) represents 0 pF differential offset
    float capacitancePF = ((float)rawData - 8388608.0) * (4.096 / 8388608.0);
    return capacitancePF;
  }
  
  return -999.0; // Error indicator if I2C fails
}

float calculateDielectricConstant(float capacitancePF) {
  float netDryCapacitance = C_DRY_PF - C_PARASITIC_PF;
  float netMeasuredCapacitance = capacitancePF - C_PARASITIC_PF;

  if (netDryCapacitance <= 0.0) {
    return 1.0; // Protect against divide-by-zero if uncalibrated
  }

  float er = netMeasuredCapacitance / netDryCapacitance;
  return er;
}

// =========================================================================
// MAIN PROGRAM
// =========================================================================

void setup() {
  Serial.begin(115200);
  delay(1000); // Startup delay for power stabilization

  Serial.println("Initializing EVAL-CN0552-PMDZ Capacitance Sensor...");
  initEVAL_CN0552();
  Serial.println("Initialization Complete.\n");
}

void loop() {
  float currentCapacitance = readCapacitancePF();

  if (currentCapacitance != -999.0) {
    float dielectricConstant = calculateDielectricConstant(currentCapacitance);

    // Output formatted results
    Serial.print("Raw Capacitance: ");
    Serial.print(currentCapacitance, 4);
    Serial.print(" pF  |  Dielectric Constant (Er): ");
    Serial.println(dielectricConstant, 4);
  } else {
    Serial.println("ERROR: Failed to read from EVAL-CN0552 board over I2C.");
  }

  delay(500); // Sample rate: 2 Hz
}
